# Copie para ".env.local" (nesta pasta mobile/) e preencha com os dados do seu projeto.
# Supabase Dashboard › Project Settings › API (ou o botão "Connect").
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública do app: "publishable" (sb_publishable_...) ou a "anon" legada (JWT).
# Nunca use a service_role / secret key nem a senha do banco no app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
