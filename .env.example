# Copie este arquivo para ".env" (na raiz do repo) e ajuste os valores.

# IP do seu PC na rede Wi-Fi (a mesma rede do celular).
# Windows: rode "ipconfig" e pegue o "Endereco IPv4" do adaptador Wi-Fi.
HOST_IP=192.168.0.10

# Como o celular acessa o servidor do Expo:
#   --lan           (padrao) mais rapido; celular e PC precisam estar na mesma rede
#   --tunnel ngrok  funciona em qualquer rede, sem conta Expo (mais lento)
#   --tunnel        tunel do Expo; exige o EXPO_TOKEN abaixo
EXPO_START_ARGS=--lan

# Token de acesso do Expo, so necessario para "--tunnel".
# Gere em expo.dev > Account settings > Access tokens.
# EXPO_TOKEN=
